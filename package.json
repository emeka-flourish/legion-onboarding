{
  "name": "legion-onboarding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "eval:ai": "vitest run --config vitest.eval.config.mts",
    "verify": "npm run typecheck && npm run lint && npm run test && E2E_PROD=1 npm run e2e",
    "export:ai-history": "python3 scripts/export-ai-history.py",
    "e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai": "4.0.91",
    "@upstash/redis": "1.39.0",
    "ai": "7.0.137",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
