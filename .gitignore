# Personal OS and editor files
.DS_Store
.obsidian/

# Node, Next.js, Vercel
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

# Secrets: never commit
.env*
!.env.example

# Screen recordings stay local: GitHub rejects files over 100 MB, and recordings can show personal details.
*.mov
*.MOV
*.mp4
*.MP4

# Full native AI logs contain injected personal context and are never committed.
# Only the exported conversation transcripts (.md) are (see ai_history/index.md).
ai_history/**/*.jsonl

# Python bytecode
__pycache__/
*.pyc

# Next.js, tests, and tooling
/node_modules
/.next/
/out/
/build
/coverage
*.pem
npm-debug.log*
next-env.d.ts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Claude Code worktrees are local only
.claude/worktrees/

# Private terms the transcript exporter redacts (local only)
.ai-history-private

# Emeka's walkthrough voice notes stay local; the AI history records how they were used (L22).
discovery/raw_discovery/voice-notes.md
