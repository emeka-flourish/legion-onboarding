# Copy this file to .env.local and fill in what you have. Never commit .env.local, and never paste keys into chat.

# --- Live AI (any subset; the app falls back to scripted responses when none work) ---
# Which provider to try first: openai | anthropic | google | scripted
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model overrides; defaults live in src/config/ai.config.ts
AI_MODEL_QUALITY=
AI_MODEL_FAST=
# Hosted-demo protection: live AI calls allowed per UTC day across all journeys (default 1500), then scripted.
AI_DAILY_LIVE_CALLS=

# --- Storage: Upstash Redis via the Vercel Marketplace ---
# Leave empty locally to use the in-memory store. `vercel env pull .env.local` fills these after provisioning.
# The app reads either pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Sessions ---
# Any long random string; signs the journey cookie and hashes phone numbers for resume lookups.
SESSION_SECRET=

# --- Demo behavior ---
# true shows the demo banner, demo controls, and on-screen text codes
DEMO_MODE=true
# 1 shortens simulated service delays (used by tests)
DEMO_FAST=

# --- RxNorm (live, free, no key) ---
# Optional. Leave empty for NLM's public API. Tests point this at an unreachable address to prove the flow survives an outage.
RXNORM_URL=
